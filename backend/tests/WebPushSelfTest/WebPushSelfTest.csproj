<Project Sdk="Microsoft.NET.Sdk">
  <!-- Web Push şifrelemesi ve VAPID imzası için birim testi (dış test paketi yok). Çalıştırma: dotnet run -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../PlanToBee.API/Infrastructure/WebPush/*.cs" Link="WebPush/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
